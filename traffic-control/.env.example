# ═════════════════════════════════════════════════════════════════════
# Standalone Traffic Control Dashboard — Environment Configuration Template
# Copy this file to .env.local inside traffic-control/
# ═════════════════════════════════════════════════════════════════════

# ─── 1. TomTom Live Traffic API Key ───
# Provides live flow tiles, corridor speeds, delays, and incident tracking.
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# ─── 2. Optional Map Provider Keys ───
# MapTiler vector basemaps key (fallback for CARTO/OSM)
VITE_MAPTILER_API_KEY=vfych9w2Nh5AGjIQ7jgL

# ─── 3. Application Polling & Defaults ───
VITE_TRAFFIC_REFRESH_INTERVAL_MS=30000
VITE_DEFAULT_CITY=mumbai
VITE_DEFAULT_MAP_STYLE=carto-dark
