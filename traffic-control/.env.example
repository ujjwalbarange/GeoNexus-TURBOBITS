# ═════════════════════════════════════════════════════════════════════
# Standalone Traffic Control Dashboard — Environment Configuration Template
# Copy this file to .env.local inside traffic-control/
# ═════════════════════════════════════════════════════════════════════

# ─── 1. Root Project Map Services ───
# URL of root application providing /api/admin/map-data and /api/hazards/map-layers
VITE_ROOT_API_URL=http://localhost:3000

# ─── 2. Basemap Style ───
# Primary map provider: osm-standard (OpenStreetMap) | carto-dark | maptiler-streets
VITE_DEFAULT_MAP_STYLE=osm-standard

# ─── 3. TomTom Live Traffic API Key ───
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# ─── 4. Optional Map Provider Keys ───
VITE_MAPTILER_API_KEY=vfych9w2Nh5AGjIQ7jgL

# ─── 5. Application Defaults ───
VITE_TRAFFIC_REFRESH_INTERVAL_MS=30000
VITE_DEFAULT_CITY=mumbai
