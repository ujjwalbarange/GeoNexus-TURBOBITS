# ═════════════════════════════════════════════════════════════════════
# Sentinel City Intelligence & Urban Link — Environment Configuration
# Template file with safe placeholders. Copy to .env.local for local runtime.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ═════════════════════════════════════════════════════════════════════

# ─── 1. TiDB Cloud Serverless / MySQL Database ───
DATABASE_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DATABASE_PORT=4000
DATABASE_USER=your_tidb_username
DATABASE_PASSWORD=your_tidb_password
DATABASE_NAME=nagpur_connect
# Optional SSL CA certificate path for strict verification
# DATABASE_SSL_CA_PATH=/path/to/ca.pem

# ─── 2. Groq AI Inference Engine ───
# Reporting AI (Urban Link Citizen Wizard)
GROQ_LLAMA_API_KEY=gsk_your_groq_api_key_here

# Sentinel Multi-Hazard Intelligence AI Engine (RAG Safety Assistant)
# Default model: openai/gpt-oss-120b with llama-3.3-70b-versatile fallback
GROQ_API_KEY=gsk_your_sentinel_groq_api_key_here

# ─── 3. Speech & Voice Input (AssemblyAI) ───
ASSEMBLY_AI_MODEL=your_assemblyai_api_key_here

# ─── 4. Application URL & Core Authentication ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ─── 5. Google OAuth 2.0 Credentials ───
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ─── 6. MapTiler Basemaps (Optional fallback for OSM) ───
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# ─── 7. Web Push VAPID Keys (Citizen Hazard Emergency Notifications) ───
VAPID_SUBJECT=mailto:admin@yourcity.gov.in
VAPID_PUBLIC_KEY=your_vapid_public_key_base64
VAPID_PRIVATE_KEY=your_vapid_private_key_base64

# ─── 8. EmailJS Citizen Dispatch (Optional) ───
EMAILJS_SERVICE_ID=service_your_service_id
EMAILJS_TEMPLATE_ID=template_your_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_CONNECTED_EMAIL=alerts@yourcity.gov.in

# ─── 9. Remote Earth Observation & Hydrological Providers ───
# Open-Meteo: Keyless for non-commercial open use. Commercial requires commercial key.
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# OpenTopography: DEM raster querying (Free with registration)
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# NASA Earthdata: High-resolution GLO-30 Copernicus DEMs (Free with registration)
NASA_EARTHDATA_TOKEN=your_earthdata_bearer_token_here
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# NASA FIRMS: Active Thermal Hotspot / Fire Alerts (Free MAP_KEY registration)
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# ISRO MOSDAC: INSAT-3D Meteorological Satellite Rainfall Ingestion (Optional)
MOSDAC_USER_EMAIL=your_isro_mosdac_email@domain.com
MOSDAC_PASSWORD=your_isro_mosdac_password
